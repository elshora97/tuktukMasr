# --- Game client (Next.js) ---------------------------------------------
# Public URL of the multiplayer race server. Baked in at build time.
# For local testing with `npm run dev:race`, use http://localhost:4000.
# In production use the https:// address (the socket then upgrades to wss://).
# While it is empty the race mode is HIDDEN from the menu (single player and
# passenger missions still work). Set it to show the «سباق مع صحابك» card.
NEXT_PUBLIC_MULTIPLAYER_URL=

# --- Race server (server/index.ts) -------------------------------------
# Port to listen on (most hosts inject PORT automatically).
PORT=4000
# Comma-separated list of allowed browser origins, e.g.
# https://toktok.example.com,https://your-app.vercel.app
# Defaults to "*" (any origin) — fine for local dev only.
CORS_ORIGIN=
# Optional: shorter course for testing (meters). Default 2400.
RACE_DISTANCE=
