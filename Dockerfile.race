# Multiplayer race server only (the game website is deployed separately).
# Build:  docker build -f Dockerfile.race -t toktok-race .
# Run:    docker run -p 8080:8080 -e CORS_ORIGIN=https://your-game toktok-race
FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY tsconfig.json ./
COPY lib ./lib
COPY server ./server
# High scores live here: mount a persistent volume at /app/data to keep them across deploys.
RUN mkdir -p /app/data && chown node:node /app/data
ENV NODE_ENV=production PORT=8080 DATA_DIR=/app/data
EXPOSE 8080
USER node
CMD ["npx", "tsx", "server/index.ts"]
